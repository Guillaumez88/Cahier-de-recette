rules_version = '2';

// Règles de sécurité de la liste de courses commune.
//
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
// Tant que ces règles ne sont pas publiées, Firestore applique les règles par
// défaut du mode choisi à la création de la base : en mode production tout est
// refusé et l'application affichera « Hors ligne » en permanence ; en mode test
// tout est ouvert pendant 30 jours puis tout se ferme d'un coup.
//
// Ce que ces règles autorisent, et pourquoi :
//
// - Une session est exigée (request.auth != null). L'application ouvre une session
//   anonyme automatiquement, sans rien demander à l'utilisateur. Sans cette
//   condition, n'importe quel robot ayant lu la clé publique dans la page pourrait
//   écrire dans la base : les clés d'API Firebase sont scannées en masse sur les
//   sites publics. Avec cette condition, il faut au moins ouvrir une session.
//
// - Seule la collection des articles de liste est accessible. Tout autre chemin
//   est refusé par défaut, y compris un chemin créé par erreur plus tard.
//
// - La forme des articles est contrôlée. Cela ne protège pas contre un utilisateur
//   mal intentionné qui aurait ouvert une session, mais cela empêche qu'un bogue
//   ou un appel malformé remplisse la base de documents inexploitables.
//
// Limite assumée : une session anonyme est gratuite et automatique, donc quelqu'un
// qui trouve l'URL du site peut lire et modifier la liste. C'est le compromis
// retenu, adapté à une liste de courses familiale. Pour aller plus loin il
// faudrait de vrais comptes, ou App Check pour n'autoriser que votre domaine.

service cloud.firestore {
  match /databases/{database}/documents {

    match /listes/{listeId}/articles/{articleId} {

      function articleValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'nom', 'recetteId', 'recetteTitre', 'coche'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 300
          && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200
          && d.recetteId is string && d.recetteId.size() <= 200
          && d.recetteTitre is string && d.recetteTitre.size() <= 300
          && d.coche is bool
          && (!d.keys().hasAny(['quantite']) || (d.quantite is string && d.quantite.size() <= 200))
          && (!d.keys().hasAny(['groupe']) || d.groupe == null || (d.groupe is string && d.groupe.size() <= 200))
          && (!d.keys().hasAny(['ajouteLe']) || d.ajouteLe == null || (d.ajouteLe is string && d.ajouteLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && articleValide();
      allow delete: if request.auth != null;
    }

    // Recettes modifiées depuis l'application. Une recette est enregistrée comme
    // une seule chaîne JSON : elle n'est jamais interrogée champ par champ côté
    // serveur, seulement lue en entier. Supprimer le document rétablit la recette
    // d'origine, qui est servie avec le site et n'est jamais modifiée.
    match /recettes/{recetteId} {

      function recetteValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'json'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.json is string && d.json.size() > 0
          // Garde-fou de taille : une recette du carnet pèse quelques kilo-octets,
          // 200 000 caractères laissent une marge très large tout en empêchant
          // qu'on remplisse la base avec un seul document.
          && d.json.size() <= 200000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && recetteValide();
      allow delete: if request.auth != null;
    }

    // Semainier commun : un document par créneau de repas, dont la clé porte la
    // date et le moment (« 2026-08-03::dejeuner »). Un créneau vide n'est pas un
    // document vide, c'est un document absent : vider un repas est une suppression.
    match /semainiers/{semainierId}/creneaux/{creneauId} {

      function creneauValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'jour', 'moment', 'type', 'titre'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 100
          // Une date au format AAAA-MM-JJ, contrôlée ici pour qu'un appel malformé
          // ne remplisse pas le semainier de créneaux que l'application ignorerait.
          && d.jour is string && d.jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.moment in ['petit-dejeuner', 'dejeuner', 'diner']
          && d.type in ['recette', 'libre']
          && d.titre is string && d.titre.size() > 0 && d.titre.size() <= 300
          && (!d.keys().hasAny(['recetteId']) || (d.recetteId is string && d.recetteId.size() <= 200))
          && (!d.keys().hasAny(['modifieLe']) || d.modifieLe == null || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && creneauValide();
      allow delete: if request.auth != null;
    }

    // Le placard : les ingrédients qu'on a toujours et qu'il ne faut pas racheter.
    // Un document par ingrédient, comme partout ailleurs : deux personnes qui
    // ajoutent chacune une entrée modifient deux documents distincts.
    //
    // Partagé et non local : le placard décrit la maison, pas l'appareil. S'il était
    // local, l'un curerait sa liste et l'autre recevrait quand même le sel dans ses
    // courses.
    match /placard/{entreeId} {

      function entreeValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'nom'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 200
          && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200;
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && entreeValide();
      allow delete: if request.auth != null;
    }

    // Photos des recettes, une par recette, en deux tailles dans le même document :
    // `vignette` pour les listes et le semainier, `grande` pour la fiche.
    //
    // Les bornes de taille ne sont pas décoratives : un document Firestore est
    // limité à 1 Mio, et une data URL en base64 pèse un tiers de plus que le
    // binaire. Sans ces bornes, un envoi trop lourd serait refusé par le serveur
    // avec une erreur de taille difficile à interpréter, ou remplirait la base.
    match /photos/{photoId} {

      function photoValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'vignette', 'grande'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.vignette is string && d.vignette.size() > 0 && d.vignette.size() <= 80000
          && d.grande is string && d.grande.size() > 0 && d.grande.size() <= 700000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && photoValide();
      allow delete: if request.auth != null;
    }
  }
}
