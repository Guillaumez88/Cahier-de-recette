rules_version = '2';

// Règles de sécurité de la liste de courses commune.
//
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
// Tant que ces règles ne sont pas publiées, Firestore applique les règles par
// défaut du mode choisi à la création de la base : en mode production tout est
// refusé et l'application affichera « Hors ligne » en permanence ; en mode test
// tout est ouvert pendant 30 jours puis tout se ferme d'un coup.
//
// Ce que ces règles autorisent, et pourquoi :
//
// - Une session est exigée (request.auth != null). L'application ouvre une session
//   anonyme automatiquement, sans rien demander à l'utilisateur. Sans cette
//   condition, n'importe quel robot ayant lu la clé publique dans la page pourrait
//   écrire dans la base : les clés d'API Firebase sont scannées en masse sur les
//   sites publics. Avec cette condition, il faut au moins ouvrir une session.
//
// - Seules les collections nommées ici sont accessibles. Tout autre chemin
//   est refusé par défaut, y compris un chemin créé par erreur plus tard.
//
// - La forme des articles est contrôlée. Cela ne protège pas contre un utilisateur
//   mal intentionné qui aurait ouvert une session, mais cela empêche qu'un bogue
//   ou un appel malformé remplisse la base de documents inexploitables.
//
// - **La lecture est ouverte, l'écriture ne l'est pas.** Le site est public : son
//   adresse suffit à le consulter, et c'est voulu, un lien peut se partager. Écrire,
//   en revanche, exige que l'appareil soit inscrit dans la collection `appareils`,
//   un document par appareil, nommé par son identifiant anonyme. Un visiteur peut
//   donc tout lire et ne rien changer, y compris depuis la console du navigateur.
//
// - **Le code de la maison ne se lit pas.** Il vit dans `menage/secret`, dont la
//   lecture est refusée à tout le monde. Seules ces règles le consultent, avec
//   get(), pour valider l'inscription d'un nouvel appareil. Il n'apparaît donc
//   nulle part dans le site ni dans la base lisible.
//
// Limite assumée : rien ne limite le nombre de tentatives d'inscription. Un code
// court se devinerait à force d'essais ; en choisir un long, d'au moins douze
// caractères. Et un appareil qui efface les données du site perd son identité
// anonyme : il faut ressaisir le code une fois.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Qui a le droit d'écrire ---------------------------------------------
    //
    // Une personne connectée avec un compte autorisé, et personne d'autre. Un compte
    // est autorisé quand il possède son document dans `comptes`, qu'il obtient en
    // présentant le code de la maison, une fois.
    //
    // Pourquoi le compte et non l'appareil : l'appareil se prête, se réinitialise et
    // se remplace ; la personne, non. Se connecter ailleurs suffit désormais à
    // retrouver ses droits, et effacer les données du site ne les fait plus perdre.
    //
    // La session anonyme, elle, ne sert plus qu'à lire.

    function estMaison() {
      return request.auth != null
        && exists(/databases/$(database)/documents/comptes/$(request.auth.uid));
    }

    // Le code de la maison. Personne ne peut le lire ni l'écrire depuis un client :
    // il se pose à la main dans la console Firebase, et seules ces règles le
    // consultent. Le changer suffit à empêcher toute nouvelle inscription.
    match /menage/{document} {
      allow read, write: if false;
    }

    // Un compte autorisé, nommé par son identifiant Firebase. Il ne peut créer que le
    // sien, et seulement avec le bon code. Ni modification ni suppression : retirer un
    // compte se fait dans la console, pour qu'aucun compte ne puisse en exclure un
    // autre.
    match /comptes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.code is string
        && request.resource.data.code == get(/databases/$(database)/documents/menage/secret).data.code;
      allow update, delete: if false;
    }

    // L'ancienne collection des appareils déverrouillés. Elle ne donne plus aucun
    // droit : elle reste déclarée le temps que les appareils encore inscrits soient
    // passés aux comptes, puis elle disparaîtra avec ses documents.
    match /appareils/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /listes/{listeId}/articles/{articleId} {

      function articleValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'nom', 'recetteId', 'recetteTitre', 'coche'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 300
          && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200
          && d.recetteId is string && d.recetteId.size() <= 200
          && d.recetteTitre is string && d.recetteTitre.size() <= 300
          && d.coche is bool
          && (!d.keys().hasAny(['quantite']) || (d.quantite is string && d.quantite.size() <= 200))
          && (!d.keys().hasAny(['groupe']) || d.groupe == null || (d.groupe is string && d.groupe.size() <= 200))
          && (!d.keys().hasAny(['ajouteLe']) || d.ajouteLe == null || (d.ajouteLe is string && d.ajouteLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if estMaison() && articleValide();
      allow delete: if estMaison();
    }

    // Recettes modifiées depuis l'application. Une recette est enregistrée comme
    // une seule chaîne JSON : elle n'est jamais interrogée champ par champ côté
    // serveur, seulement lue en entier. Supprimer le document rétablit la recette
    // d'origine, qui est servie avec le site et n'est jamais modifiée.
    match /recettes/{recetteId} {

      function recetteValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'json'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.json is string && d.json.size() > 0
          // Garde-fou de taille : une recette du carnet pèse quelques kilo-octets,
          // 200 000 caractères laissent une marge très large tout en empêchant
          // qu'on remplisse la base avec un seul document.
          && d.json.size() <= 200000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if estMaison() && recetteValide();
      allow delete: if estMaison();
    }

    // Semainier commun : un document par créneau de repas, dont la clé porte la
    // date et le moment (« 2026-08-03::dejeuner »). Un créneau vide n'est pas un
    // document vide, c'est un document absent : vider un repas est une suppression.
    match /semainiers/{semainierId}/creneaux/{creneauId} {

      function creneauValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'jour', 'moment', 'type', 'titre'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 100
          // Une date au format AAAA-MM-JJ, contrôlée ici pour qu'un appel malformé
          // ne remplisse pas le semainier de créneaux que l'application ignorerait.
          && d.jour is string && d.jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.moment in ['petit-dejeuner', 'dejeuner', 'diner']
          && d.type in ['recette', 'libre']
          && d.titre is string && d.titre.size() > 0 && d.titre.size() <= 300
          && (!d.keys().hasAny(['recetteId']) || (d.recetteId is string && d.recetteId.size() <= 200))
          && (!d.keys().hasAny(['modifieLe']) || d.modifieLe == null || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if estMaison() && creneauValide();
      allow delete: if estMaison();
    }

    // Le placard : les ingrédients qu'on a toujours et qu'il ne faut pas racheter.
    // Un document par ingrédient, comme partout ailleurs : deux personnes qui
    // ajoutent chacune une entrée modifient deux documents distincts.
    //
    // Partagé et non local : le placard décrit la maison, pas l'appareil. S'il était
    // local, l'un curerait sa liste et l'autre recevrait quand même le sel dans ses
    // courses.
    match /placard/{entreeId} {

      function entreeValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'nom'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 200
          && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200;
      }

      allow read: if request.auth != null;
      allow create, update: if estMaison() && entreeValide();
      allow delete: if estMaison();
    }

    // La bibliothèque : les livres de cuisine « en vrai » de la maison, chacun étant
    // une étagère à laquelle on rattache des recettes au fil de leur import. Le livre
    // ne porte pas ses recettes : c'est la recette qui nomme son livre, dans son
    // propre document. Un livre est donc un document minuscule, et le supprimer ne
    // supprime aucune recette.
    match /livres/{livreId} {

      function livreValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'titre', 'theme'])
          && d.id is string && d.id.size() > 0 && d.id.size() <= 200
          && d.titre is string && d.titre.size() > 0 && d.titre.size() <= 300
          && d.theme is string && d.theme.size() > 0 && d.theme.size() <= 100
          && (!d.keys().hasAny(['auteur']) || d.auteur == null || (d.auteur is string && d.auteur.size() <= 200))
          && (!d.keys().hasAny(['modifieLe']) || d.modifieLe == null || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if estMaison() && livreValide();
      allow delete: if estMaison();
    }

    // Illustrations des étapes d'une recette : un document par recette, contenant
    // toutes ses illustrations dans une seule chaîne JSON indexée par rang d'étape.
    //
    // Pourquoi un document par recette et non un par étape : ces images ne servent que
    // sur la fiche ouverte. Un document par étape les ferait toutes lire au chargement
    // de la page, avec les vignettes de la collection `photos`, alors qu'elles ne sont
    // utiles qu'une fois la fiche affichée. Ici, c'est une lecture par fiche consultée.
    //
    // La borne de taille n'est pas décorative : un document Firestore est limité à
    // 1 Mio. Chaque illustration est une vignette de 320 px de côté, bornée à 60 000
    // caractères par photos.js, donc six étapes tiennent largement sous 600 000.
    match /illustrations/{recetteId} {

      function illustrationsValides() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'json'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.json is string && d.json.size() > 0 && d.json.size() <= 600000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if estMaison() && illustrationsValides();
      allow delete: if estMaison();
    }

    // Photos des recettes, une par recette, en deux tailles dans le même document :
    // `vignette` pour les listes et le semainier, `grande` pour la fiche.
    //
    // Les bornes de taille ne sont pas décoratives : un document Firestore est
    // limité à 1 Mio, et une data URL en base64 pèse un tiers de plus que le
    // binaire. Sans ces bornes, un envoi trop lourd serait refusé par le serveur
    // avec une erreur de taille difficile à interpréter, ou remplirait la base.
    match /photos/{photoId} {

      function photoValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'vignette', 'grande'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.vignette is string && d.vignette.size() > 0 && d.vignette.size() <= 80000
          && d.grande is string && d.grande.size() > 0 && d.grande.size() <= 700000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create, update: if estMaison() && photoValide();
      allow delete: if estMaison();
    }
  }
}
