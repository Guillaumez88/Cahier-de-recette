rules_version = '2';

// Règles de sécurité du carnet de recettes.
//
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
// Tant que ces règles ne sont pas publiées, Firestore applique les règles par
// défaut du mode choisi à la création de la base : en mode production tout est
// refusé et l'application affichera « Hors ligne » en permanence ; en mode test
// tout est ouvert pendant 30 jours puis tout se ferme d'un coup.
//
// Le modèle, en trois phrases :
//
// - **Un foyer possède les données.** Toutes les collections de contenu vivent sous
//   `foyers/{foyerId}/…`. L'identifiant du foyer est celui du compte qui l'a créé :
//   pas de tirage aléatoire, pas de collision, et une règle triviale à écrire.
//
// - **Un membre est un document du foyer**, nommé par l'identifiant de son compte et
//   portant son rôle : « modification » ou « lecture ». Le compte qui crée un foyer
//   s'y inscrit lui-même en modification : c'est le seul membre qui s'auto-inscrit,
//   et seulement dans le foyer qui porte son propre identifiant. Tous les autres sont
//   inscrits par un membre qui peut modifier, depuis la page des membres du foyer.
//
// - **`utilisateurs/{uid}` dit à quel foyer un compte appartient.** C'est la première
//   chose lue à l'ouverture : sans elle, l'application ne sait pas quoi afficher.
//
// Il n'y a plus de code de la maison : rien à retenir, rien à se transmettre, rien à
// deviner par tâtonnement. Entrer dans un foyer suppose qu'un membre vous y inscrive.
//
// Ce que ces règles ne font pas, et qu'il faut savoir :
//
// - **Elles n'empêchent pas de créer un compte.** N'importe qui peut s'inscrire et
//   obtenir son propre foyer, vide. Le bloquer demanderait une fonction de blocage
//   Identity Platform, qui est payante. Un compte inconnu ne voit rien du vôtre.
//
// - **La lecture d'un foyer est réservée à ses membres.** Contrairement à la version
//   précédente, un visiteur non inscrit ne lit rien : le partage se fera par des
//   documents dédiés, pas en ouvrant la lecture à tout le monde.
//
// - **Chaque requête de contenu déclenche un `get()` sur le document de membre**, qui
//   est facturé comme une lecture. C'est le prix du cloisonnement : une lecture de
//   plus par requête, pas par document lu.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Appartenance et rôles -----------------------------------------------

    function estConnecte() {
      return request.auth != null;
    }

    function membre(foyerId) {
      return get(/databases/$(database)/documents/foyers/$(foyerId)/membres/$(request.auth.uid)).data;
    }

    function estMembre(foyerId) {
      return estConnecte()
        && exists(/databases/$(database)/documents/foyers/$(foyerId)/membres/$(request.auth.uid));
    }

    function peutModifier(foyerId) {
      return estMembre(foyerId) && membre(foyerId).role == 'modification';
    }

    // --- La fiche d'un compte : son foyer -------------------------------------
    //
    // Chacun lit et écrit la sienne. Un membre qui peut modifier écrit aussi celle du
    // compte qu'il vient d'inscrire, à condition qu'elle désigne son propre foyer : il
    // ne peut donc pas déplacer quelqu'un d'autre vers un foyer tiers.

    match /utilisateurs/{uid} {
      function ficheValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['email', 'foyer'])
          && d.email is string && d.email.size() <= 320
          && d.foyer is string && d.foyer.size() > 0 && d.foyer.size() <= 200;
      }

      allow read: if estConnecte() && request.auth.uid == uid;
      allow create, update: if estConnecte()
        && ficheValide()
        && (request.auth.uid == uid || peutModifier(request.resource.data.foyer));
      allow delete: if false;
    }

    // --- Le foyer --------------------------------------------------------------
    //
    // On ne crée que le foyer qui porte son propre identifiant de compte : un compte,
    // un foyer au plus, et aucune façon de créer un foyer au nom d'un autre. Le
    // supprimer n'est pas possible depuis l'application : cela laisserait des sous-
    // collections orphelines qu'aucun client ne saurait nettoyer.

    match /foyers/{foyerId} {
      function foyerValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['nom', 'proprietaire'])
          && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200
          && d.proprietaire is string && d.proprietaire == foyerId
          && (!d.keys().hasAny(['creeLe']) || (d.creeLe is string && d.creeLe.size() <= 40));
      }

      allow read: if estMembre(foyerId);
      allow create: if estConnecte() && request.auth.uid == foyerId && foyerValide();
      allow update: if peutModifier(foyerId) && foyerValide();
      allow delete: if false;
    }

    // --- Les membres du foyer ---------------------------------------------------
    //
    // Le fondateur s'inscrit lui-même, en modification, dans le foyer qui porte son
    // identifiant : c'est l'amorçage, et la seule auto-inscription possible. Ensuite,
    // seul un membre qui peut modifier inscrit, change ou retire quelqu'un.
    //
    // Personne ne peut se retirer soi-même ni se promouvoir : `peutModifier` est
    // évalué sur le document déjà en base, pas sur celui qu'on envoie.

    match /foyers/{foyerId}/membres/{uid} {
      function membreValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['email', 'role'])
          && d.email is string && d.email.size() <= 320
          && d.role in ['modification', 'lecture']
          && (!d.keys().hasAny(['ajouteLe']) || (d.ajouteLe is string && d.ajouteLe.size() <= 40));
      }

      // L'amorçage : le tout premier membre d'un foyer neuf, qui est son fondateur.
      function amorcage() {
        return estConnecte()
          && request.auth.uid == uid
          && uid == foyerId
          && request.resource.data.role == 'modification';
      }

      allow read: if estMembre(foyerId);
      allow create: if membreValide() && (amorcage() || peutModifier(foyerId));
      allow update: if membreValide() && peutModifier(foyerId);
      // Le fondateur ne se retire pas : un foyer sans personne pour y écrire serait
      // définitivement figé, et aucun client ne saurait le rouvrir.
      allow delete: if peutModifier(foyerId) && uid != foyerId;
    }

    // --- Le contenu du foyer -----------------------------------------------------
    //
    // Sept collections, toutes sous le foyer, toutes soumises à la même règle : un
    // membre lit, un membre en modification écrit. Les contrôles de forme, eux, sont
    // propres à chaque collection : ils n'empêchent pas un membre mal intentionné de
    // saboter son propre foyer, ils empêchent un bogue de remplir la base de documents
    // inexploitables.

    match /foyers/{foyerId}/articles/{articleId} {
      function articleValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'nom', 'recetteId', 'recetteTitre', 'coche'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 300
          && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200
          && d.recetteId is string && d.recetteId.size() <= 200
          && d.recetteTitre is string && d.recetteTitre.size() <= 300
          && d.coche is bool
          && (!d.keys().hasAny(['quantite']) || (d.quantite is string && d.quantite.size() <= 200))
          && (!d.keys().hasAny(['groupe']) || d.groupe == null || (d.groupe is string && d.groupe.size() <= 200))
          && (!d.keys().hasAny(['ajouteLe']) || d.ajouteLe == null || (d.ajouteLe is string && d.ajouteLe.size() <= 40));
      }

      allow read: if estMembre(foyerId);
      allow create, update: if peutModifier(foyerId) && articleValide();
      allow delete: if peutModifier(foyerId);
    }

    // Recettes modifiées depuis l'application. Une recette est enregistrée comme
    // une seule chaîne JSON : elle n'est jamais interrogée champ par champ côté
    // serveur, seulement lue en entier. Supprimer le document rétablit la recette
    // d'origine, qui est servie avec le site et n'est jamais modifiée.
    match /foyers/{foyerId}/recettes/{recetteId} {
      function recetteValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'json'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.json is string && d.json.size() > 0
          // Garde-fou de taille : une recette du carnet pèse quelques kilo-octets,
          // 200 000 caractères laissent une marge très large tout en empêchant
          // qu'on remplisse la base avec un seul document.
          && d.json.size() <= 200000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if estMembre(foyerId);
      allow create, update: if peutModifier(foyerId) && recetteValide();
      allow delete: if peutModifier(foyerId);
    }

    // Semainier du foyer : un document par créneau de repas, dont la clé porte la
    // date et le moment (« 2026-08-03::dejeuner »). Un créneau vide n'est pas un
    // document vide, c'est un document absent : vider un repas est une suppression.
    match /foyers/{foyerId}/creneaux/{creneauId} {
      function creneauValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'jour', 'moment', 'type', 'titre'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 100
          // Une date au format AAAA-MM-JJ, contrôlée ici pour qu'un appel malformé
          // ne remplisse pas le semainier de créneaux que l'application ignorerait.
          && d.jour is string && d.jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.moment in ['petit-dejeuner', 'dejeuner', 'diner']
          && d.type in ['recette', 'libre']
          && d.titre is string && d.titre.size() > 0 && d.titre.size() <= 300
          && (!d.keys().hasAny(['recetteId']) || (d.recetteId is string && d.recetteId.size() <= 200))
          && (!d.keys().hasAny(['modifieLe']) || d.modifieLe == null || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if estMembre(foyerId);
      allow create, update: if peutModifier(foyerId) && creneauValide();
      allow delete: if peutModifier(foyerId);
    }

    // Le placard : les ingrédients qu'on a toujours et qu'il ne faut pas racheter.
    // Un document par ingrédient, comme partout ailleurs : deux personnes qui
    // ajoutent chacune une entrée modifient deux documents distincts.
    match /foyers/{foyerId}/placard/{entreeId} {
      function entreeValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['cle', 'nom'])
          && d.cle is string && d.cle.size() > 0 && d.cle.size() <= 200
          && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200;
      }

      allow read: if estMembre(foyerId);
      allow create, update: if peutModifier(foyerId) && entreeValide();
      allow delete: if peutModifier(foyerId);
    }

    // La bibliothèque : les livres de cuisine « en vrai » du foyer, chacun étant une
    // étagère à laquelle on rattache des recettes au fil de leur import. Le livre ne
    // porte pas ses recettes : c'est la recette qui nomme son livre, dans son propre
    // document. Un livre est donc un document minuscule, et le supprimer ne supprime
    // aucune recette.
    match /foyers/{foyerId}/livres/{livreId} {
      function livreValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'titre', 'theme'])
          && d.id is string && d.id.size() > 0 && d.id.size() <= 200
          && d.titre is string && d.titre.size() > 0 && d.titre.size() <= 300
          && d.theme is string && d.theme.size() > 0 && d.theme.size() <= 100
          && (!d.keys().hasAny(['auteur']) || d.auteur == null || (d.auteur is string && d.auteur.size() <= 200))
          && (!d.keys().hasAny(['modifieLe']) || d.modifieLe == null || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if estMembre(foyerId);
      allow create, update: if peutModifier(foyerId) && livreValide();
      allow delete: if peutModifier(foyerId);
    }

    // Illustrations des étapes d'une recette : un document par recette, contenant
    // toutes ses illustrations dans une seule chaîne JSON indexée par rang d'étape.
    //
    // Pourquoi un document par recette et non un par étape : ces images ne servent que
    // sur la fiche ouverte. Un document par étape les ferait toutes lire au chargement
    // de la page, avec les vignettes de la collection `photos`, alors qu'elles ne sont
    // utiles qu'une fois la fiche affichée. Ici, c'est une lecture par fiche consultée.
    //
    // La borne de taille n'est pas décorative : un document Firestore est limité à
    // 1 Mio. Chaque illustration est une vignette de 320 px de côté, bornée à 60 000
    // caractères par photos.js, donc six étapes tiennent largement sous 600 000.
    match /foyers/{foyerId}/illustrations/{recetteId} {
      function illustrationsValides() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'json'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.json is string && d.json.size() > 0 && d.json.size() <= 600000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if estMembre(foyerId);
      allow create, update: if peutModifier(foyerId) && illustrationsValides();
      allow delete: if peutModifier(foyerId);
    }

    // Photos des recettes, une par recette, en deux tailles dans le même document :
    // `vignette` pour les listes et le semainier, `grande` pour la fiche.
    //
    // Les bornes de taille ne sont pas décoratives : un document Firestore est
    // limité à 1 Mio, et une data URL en base64 pèse un tiers de plus que le
    // binaire. Sans ces bornes, un envoi trop lourd serait refusé par le serveur
    // avec une erreur de taille difficile à interpréter, ou remplirait la base.
    match /foyers/{foyerId}/photos/{photoId} {
      function photoValide() {
        let d = request.resource.data;
        return d.keys().hasAll(['recetteId', 'vignette', 'grande'])
          && d.recetteId is string && d.recetteId.size() > 0 && d.recetteId.size() <= 200
          && d.vignette is string && d.vignette.size() > 0 && d.vignette.size() <= 80000
          && d.grande is string && d.grande.size() > 0 && d.grande.size() <= 700000
          && (!d.keys().hasAny(['modifieLe']) || (d.modifieLe is string && d.modifieLe.size() <= 40));
      }

      allow read: if estMembre(foyerId);
      allow create, update: if peutModifier(foyerId) && photoValide();
      allow delete: if peutModifier(foyerId);
    }

    // --- Les collections d'avant les foyers --------------------------------------
    //
    // `listes`, `recettes`, `semainiers`, `placard`, `livres`, `illustrations`,
    // `photos` à la racine, plus `comptes`, `appareils` et `menage` : elles ont porté
    // les données jusqu'à la migration vers les foyers. Elles restent lisibles par un
    // compte connecté, le temps que la copie soit vérifiée, et ne sont plus écrites
    // par personne. Elles disparaîtront avec leurs documents.

    match /listes/{listeId}/articles/{articleId} {
      allow read: if estConnecte();
      allow write: if false;
    }
    match /recettes/{recetteId} {
      allow read: if estConnecte();
      allow write: if false;
    }
    match /semainiers/{semainierId}/creneaux/{creneauId} {
      allow read: if estConnecte();
      allow write: if false;
    }
    match /placard/{entreeId} {
      allow read: if estConnecte();
      allow write: if false;
    }
    match /livres/{livreId} {
      allow read: if estConnecte();
      allow write: if false;
    }
    match /illustrations/{recetteId} {
      allow read: if estConnecte();
      allow write: if false;
    }
    match /photos/{photoId} {
      allow read: if estConnecte();
      allow write: if false;
    }
    match /comptes/{uid} {
      allow read: if estConnecte() && request.auth.uid == uid;
      allow write: if false;
    }
    match /appareils/{uid} {
      allow read: if estConnecte() && request.auth.uid == uid;
      allow write: if false;
    }
    match /menage/{document} {
      allow read, write: if false;
    }
  }
}
